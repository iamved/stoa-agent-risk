{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "demo.stoa-agent-risk.dev"
        }
      ],
      "destination": "/dashboard"
    },
    {
      "source": "/agent-risk",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/red",
      "destination": "https://stoa-red.dev",
      "permanent": false
    }
  ]
}
